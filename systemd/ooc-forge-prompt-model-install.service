[Unit]
Description=Install the OOC Forge local prompt compiler model
After=network-online.target ooc-forge-init.service
Wants=network-online.target
Requires=ooc-forge-init.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/ooc-forge/forge.env
ExecStart=/usr/local/sbin/ooc-forge-prompt-model-install
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
