[Unit]
Description=OOC Forge web interface
After=network.target ooc-forge-init.service
Requires=ooc-forge-init.service

[Service]
Type=simple
User=forge
Group=forge
EnvironmentFile=-/etc/ooc-forge/forge.env
WorkingDirectory=/opt/ooc-forge
ExecStart=/opt/ooc-forge/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8080 --access-logfile - forge.app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
