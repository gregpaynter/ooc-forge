#!/bin/sh
set -eu

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

FORGE_USER=forge
FORGE_DATA=/forge-data
SOURCE_DIR=/opt/ooc-forge

if ! id "$FORGE_USER" >/dev/null 2>&1; then
  useradd --system --create-home --home-dir /var/lib/ooc-forge --shell /usr/sbin/nologin "$FORGE_USER"
fi

install -d -o "$FORGE_USER" -g "$FORGE_USER" -m 0750 "$FORGE_DATA"
install -d -m 0755 /etc/ooc-forge

python3 -m venv --system-site-packages "$SOURCE_DIR/.venv"
"$SOURCE_DIR/.venv/bin/pip" install \
  --no-deps \
  --no-build-isolation \
  --disable-pip-version-check \
  "$SOURCE_DIR"

cat > /etc/ooc-forge/forge.env <<'ENV'
FORGE_DATA_ROOT=/forge-data
COMFYUI_URL=http://127.0.0.1:8188
FORGE_POLL_INTERVAL=5
FORGE_DEFAULT_CHECKPOINT=
ENV
chmod 0640 /etc/ooc-forge/forge.env
chown root:"$FORGE_USER" /etc/ooc-forge/forge.env

cat > /etc/ooc-forge/comfyui-model-paths.yaml <<'YAML'
ooc_forge:
  base_path: /forge-data
  is_default: true
  checkpoints: models/checkpoints
  loras: models/loras
  vae: models/vae
  text_encoders: models/text_encoders
  diffusion_models: models/diffusion_models
  clip_vision: models/clip_vision
  controlnet: models/controlnet
  upscale_models: models/upscale_models
  embeddings: models/embeddings
YAML
chmod 0644 /etc/ooc-forge/comfyui-model-paths.yaml

for unit in \
  ooc-forge-appliance-policy \
  ooc-forge-init \
  ooc-forge-gpu-init \
  ooc-forge-web \
  ooc-forge-worker \
  ooc-forge-sync \
  comfyui; do
  install -m 0644 "$SOURCE_DIR/systemd/$unit.service" "/etc/systemd/system/$unit.service"
done
install -m 0644 "$SOURCE_DIR/systemd/ooc-forge-git-update.service" /etc/systemd/system/ooc-forge-git-update.service
install -m 0440 "$SOURCE_DIR/systemd/ooc-forge-maintenance.sudoers" /etc/sudoers.d/ooc-forge-maintenance
install -m 0755 "$SOURCE_DIR/scripts/ooc-forge-git-update" /usr/local/sbin/ooc-forge-git-update
install -m 0755 "$SOURCE_DIR/scripts/ooc-forge-appliance-policy" /usr/local/sbin/ooc-forge-appliance-policy
install -m 0755 "$SOURCE_DIR/scripts/ooc-forge-gpu-init" /usr/local/sbin/ooc-forge-gpu-init

# The RTX 3090 reference appliance uses the proprietary NVIDIA driver. Nouveau
# claiming the GPU first leaves nvidia-smi unable to communicate with it, so the
# conflict is resolved in the image rather than by post-install shell repair.
install -d -m 0755 /etc/modprobe.d
cat > /etc/modprobe.d/blacklist-nouveau.conf <<'EOF'
blacklist nouveau
options nouveau modeset=0
EOF

# Prove that DKMS installed both the core NVIDIA driver and UVM for every kernel
# carried in the image, then rebuild initramfs with the Nouveau blacklist.
for module_dir in /lib/modules/*; do
  [ -d "$module_dir" ] || continue
  kernel=$(basename "$module_dir")
  if [ -d "/usr/src/linux-headers-$kernel" ]; then
    dkms autoinstall -k "$kernel"
  fi
  depmod -a "$kernel"
done
if ! find /lib/modules -type f \( -name 'nvidia-current.ko*' -o -name 'nvidia.ko*' \) -print -quit | grep -q .; then
  echo "NVIDIA DKMS core module was not installed into the Forge image" >&2
  exit 1
fi
if ! find /lib/modules -type f \( -name 'nvidia-current-uvm.ko*' -o -name 'nvidia-uvm.ko*' -o -name 'nvidia_uvm.ko*' \) -print -quit | grep -q .; then
  echo "NVIDIA DKMS UVM module was not installed into the Forge image" >&2
  exit 1
fi
update-initramfs -u -k all

# Bundle the pinned ComfyUI + PyTorch CUDA runtime. Models remain separate
# persistent Forge Data and are not baked into the base image.
"$SOURCE_DIR/scripts/install-comfyui-runtime"

rm -f /etc/nginx/sites-enabled/default
install -m 0644 "$SOURCE_DIR/nginx/ooc-forge.conf" /etc/nginx/sites-available/ooc-forge
ln -sfn /etc/nginx/sites-available/ooc-forge /etc/nginx/sites-enabled/ooc-forge

echo forge > /etc/hostname
if grep -q '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
  sed -i 's/^127\.0\.1\.1.*/127.0.1.1\tforge/' /etc/hosts
else
  printf '127.0.1.1\tforge\n' >> /etc/hosts
fi

# Never ship live-build's SSH host identity into installed appliances. The
# appliance-policy service runs before ssh.service and creates unique keys with
# ssh-keygen -A on each installation's first boot.
rm -f /etc/ssh/ssh_host_*

systemctl enable ooc-forge-appliance-policy.service
systemctl enable NetworkManager.service
systemctl enable avahi-daemon.service
systemctl enable nginx.service
systemctl enable ssh.service
systemctl enable nvidia-persistenced.service
systemctl enable ooc-forge-init.service
systemctl enable ooc-forge-gpu-init.service
systemctl enable comfyui.service
systemctl enable ooc-forge-web.service
systemctl enable ooc-forge-worker.service
systemctl enable ooc-forge-sync.service

# This marker makes the ISO's UEFI boot test observable over a serial console.
# It only runs on the live image, whose kernel command line carries the matching
# flag; an installed appliance does not emit the marker. Being WantedBy the
# multi-user target is sufficient; ordering it After the same target creates an
# avoidable target/service ordering cycle.
cat > /etc/systemd/system/ooc-forge-boot-smoke.service <<'UNIT'
[Unit]
Description=Signal that the OOC Forge live image reached multi-user boot
ConditionKernelCommandLine=ooc-forge.boot-smoke=1
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf "OOC_FORGE_UEFI_BOOT_OK\\n" > /dev/ttyS0'

[Install]
WantedBy=multi-user.target
UNIT
systemctl enable ooc-forge-boot-smoke.service

# The Git updater is intentionally not enabled on a timer. It is an on-demand,
# admin-confirmed Developer/Maintenance action started by the fixed sudoers rule.
