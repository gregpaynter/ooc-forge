#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run as root." >&2
  exit 1
fi

FORGE_USER=${FORGE_USER:-forge}
FORGE_DATA_ROOT=${FORGE_DATA_ROOT:-/forge-data}
STATUS="$FORGE_DATA_ROOT/maintenance/audio-model-install-status.json"
CACHE_ROOT="$FORGE_DATA_ROOT/cache/model-downloads/stable-audio-3-medium-base"
LAST_STATE=QUEUED

FILES=(
  'checkpoints|stable_audio_3_medium_base.safetensors|c443fcc4d491475064cd0ff3eb92459b1e5f5060e86d96d016f048e528e24195|https://huggingface.co/Comfy-Org/stable-audio-3/resolve/main/checkpoints/stable_audio_3_medium_base.safetensors?download=true'
  'text_encoders|t5gemma_b_b_ul2.safetensors|1e1eba25be8872edb0d3c6335c6658fd6388e7b14b60da6e454e404cfcd8150e|https://huggingface.co/Comfy-Org/stable-audio-3/resolve/main/text_encoders/t5gemma_b_b_ul2.safetensors?download=true'
)

write_status() {
  local state=$1 message=$2 current=${3:-}
  LAST_STATE=$state
  install -d -o "$FORGE_USER" -g "$FORGE_USER" -m 0750 "$(dirname "$STATUS")"
  python3 - "$STATUS" "$state" "$message" "$current" <<'PY'
import json, os, sys
from datetime import datetime, timezone
from pathlib import Path
p=Path(sys.argv[1]); value={"state":sys.argv[2],"message":sys.argv[3],"current_file":sys.argv[4] or None,"model":{"id":"stable-audio-3-medium-base","name":"Stable Audio 3 Medium Base","license_url":"https://huggingface.co/Comfy-Org/stable-audio-3"},"updated_at":datetime.now(timezone.utc).isoformat()}
t=p.with_name(f".{p.name}.tmp"); t.write_text(json.dumps(value,indent=2)+"\n",encoding="utf-8"); os.chmod(t,0o644); t.replace(p)
PY
  chown "$FORGE_USER:$FORGE_USER" "$STATUS"
}

sha_matches() {
  local path=$1 expected=$2
  [[ -f "$path" ]] && [[ "$(sha256sum "$path" | awk '{print $1}')" == "$expected" ]]
}

trap 'rc=$?; [[ "$LAST_STATE" == FAILED || "$LAST_STATE" == COMPLETED ]] || write_status FAILED "Stable Audio 3 model installation failed. Inspect journalctl -u ooc-forge-audio-model-install.service."; exit $rc' ERR

write_status QUEUED "Preparing the Stable Audio 3 Medium Base model stack."
install -d -o "$FORGE_USER" -g "$FORGE_USER" -m 0750 "$CACHE_ROOT"

for spec in "${FILES[@]}"; do
  IFS='|' read -r directory filename expected url <<<"$spec"
  target_dir="$FORGE_DATA_ROOT/models/$directory"
  target="$target_dir/$filename"
  part="$CACHE_ROOT/$filename.part"
  install -d -o "$FORGE_USER" -g "$FORGE_USER" -m 0750 "$target_dir"

  if [[ -f "$target" ]]; then
    sha_matches "$target" "$expected" || { write_status FAILED "Existing $filename has an unexpected SHA-256." "$filename"; exit 1; }
    continue
  fi

  write_status DOWNLOADING "Downloading Stable Audio 3 component: $filename. Downloads are resumable." "$filename"
  if ! curl --fail --location --retry 5 --retry-delay 2 --retry-all-errors --continue-at - --output "$part" "$url"; then
    rm -f "$part"
    curl --fail --location --retry 5 --retry-delay 2 --retry-all-errors --output "$part" "$url"
  fi

  write_status VERIFYING "Verifying $filename against its pinned SHA-256." "$filename"
  if ! sha_matches "$part" "$expected"; then
    rm -f "$part"
    write_status DOWNLOADING "Checksum mismatch for $filename; retrying one clean download from byte zero." "$filename"
    curl --fail --location --retry 5 --retry-delay 2 --retry-all-errors --output "$part" "$url"
    write_status VERIFYING "Verifying clean retry of $filename against its pinned SHA-256." "$filename"
    sha_matches "$part" "$expected" || { rm -f "$part"; write_status FAILED "Downloaded $filename SHA-256 did not match after a clean retry." "$filename"; exit 1; }
  fi

  write_status INSTALLING "Installing verified $filename into persistent Forge Data." "$filename"
  chown "$FORGE_USER:$FORGE_USER" "$part"
  chmod 0644 "$part"
  mv "$part" "$target"
done

systemctl try-restart comfyui.service ooc-forge-worker.service >/dev/null 2>&1 || true
write_status COMPLETED "Stable Audio 3 Medium Base model stack is installed."
echo "Stable Audio 3 Medium Base model stack installed successfully."
