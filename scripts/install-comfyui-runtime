#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run as root." >&2
  exit 1
fi

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=/dev/null
source "$SCRIPT_DIR/comfyui-runtime.env"

COMFYUI_DIR=${COMFYUI_DIR:-/opt/ComfyUI}
PYTHON=${PYTHON:-python3}
VENV="$COMFYUI_DIR/.venv"

for command in git "$PYTHON"; do
  command -v "$command" >/dev/null || {
    echo "Required command not found: $command" >&2
    exit 1
  }
done

rm -rf "$COMFYUI_DIR"
install -d -m 0755 "$COMFYUI_DIR"
git -C "$COMFYUI_DIR" init -q
git -C "$COMFYUI_DIR" remote add origin https://github.com/Comfy-Org/ComfyUI.git
git -C "$COMFYUI_DIR" fetch -q --depth 1 origin "$COMFYUI_COMMIT"
git -C "$COMFYUI_DIR" checkout -q --detach FETCH_HEAD

actual_commit=$(git -C "$COMFYUI_DIR" rev-parse HEAD)
if [[ "$actual_commit" != "$COMFYUI_COMMIT" ]]; then
  echo "ComfyUI commit mismatch: expected $COMFYUI_COMMIT, got $actual_commit" >&2
  exit 1
fi

"$PYTHON" -m venv "$VENV"
"$VENV/bin/python" -m pip install --disable-pip-version-check --no-cache-dir --upgrade pip setuptools wheel
"$VENV/bin/python" -m pip install --disable-pip-version-check --no-cache-dir \
  "torch==$TORCH_VERSION" \
  "torchvision==$TORCHVISION_VERSION" \
  "torchaudio==$TORCHAUDIO_VERSION" \
  --index-url "$PYTORCH_INDEX_URL"
"$VENV/bin/python" -m pip install --disable-pip-version-check --no-cache-dir \
  -r "$COMFYUI_DIR/requirements.txt"
"$VENV/bin/python" -m pip check

"$VENV/bin/python" - "$TORCH_VERSION" "$PYTORCH_CUDA_VERSION" <<'PY'
import sys
import torch

expected_torch, expected_cuda = sys.argv[1:]
actual_torch = torch.__version__.split("+", 1)[0]
if actual_torch != expected_torch:
    raise SystemExit(f"Unexpected torch version: {torch.__version__}")
if torch.version.cuda != expected_cuda:
    raise SystemExit(f"Unexpected CUDA runtime: {torch.version.cuda!r}")
print(f"OOC Forge PyTorch runtime verified: torch={torch.__version__} cuda={torch.version.cuda}")
PY

# main.py --help exercises the pinned ComfyUI environment without requiring a
# physical GPU on the ISO build host.
"$VENV/bin/python" "$COMFYUI_DIR/main.py" --help >/dev/null

install -d -m 0755 /etc/ooc-forge
cat > /etc/ooc-forge/comfyui-runtime.env <<ENV
COMFYUI_VERSION=$COMFYUI_VERSION
COMFYUI_COMMIT=$COMFYUI_COMMIT
TORCH_VERSION=$TORCH_VERSION
TORCHVISION_VERSION=$TORCHVISION_VERSION
TORCHAUDIO_VERSION=$TORCHAUDIO_VERSION
PYTORCH_INDEX_URL=$PYTORCH_INDEX_URL
PYTORCH_CUDA_VERSION=$PYTORCH_CUDA_VERSION
ENV
chmod 0644 /etc/ooc-forge/comfyui-runtime.env

# Runtime software is immutable appliance content. Mutable state is redirected
# by systemd into persistent /forge-data paths.
chown -R root:root "$COMFYUI_DIR"
chmod -R a+rX "$COMFYUI_DIR"

echo "Pinned OOC Forge ComfyUI runtime installed at $COMFYUI_DIR."
